# Server-only Azure settings. Store the real key in ignored .env, never EXPO_PUBLIC_.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://melenai-resource.openai.azure.com/openai/v1
AZURE_OPENAI_CHAT_MODEL=melenai-gpt-6-luna
AZURE_OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini

# Optional deployed authenticated backend; development automatically uses Metro.
# EXPO_PUBLIC_AI_BACKEND_URL=https://your-backend.example/api/ai
# Optional public HTTPS GLB URL. Leave unset to use the bundled model.
# EXPO_PUBLIC_MODEL_URL=https://your-host.example/character.glb
