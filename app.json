{
  "expo": {
    "name": "Melen AI Companion",
    "slug": "melen-ai-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.melen.aicompanion",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Melen AI requires microphone access to speak with your 3D AI companion."
      }
    },
    "android": {
      "package": "com.melen.aicompanion",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "Melen AI requires microphone access to speak with your 3D AI companion."
        }
      ],
      "expo-router",
      "expo-font"
    ],
    "scheme": "melen",
    "platforms": [
      "ios",
      "android"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ca66264d-3bfd-407a-9c05-f46e8d824570"
      }
    },
    "owner": "mohit14-2"
  }
}
